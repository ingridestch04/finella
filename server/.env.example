DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finella?appName=<AppName>

REDIS_URL=redis://localhost:6379

JWT_SECRET=changeme-at-least-32-characters-long
JWT_REFRESH_SECRET=changeme-refresh-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=changeme-32-chars-minimum-here-ok
HMAC_SECRET=changeme-16chars

ALLOWED_ORIGINS=http://localhost:5173
PORT=3000
NODE_ENV=development

# Plaid — https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
